{
	"schemaVersion": 1,
	"id": "vantage",
	"version": "${version}",
	"name": "Vantage - Auto Camera for Mounts",
	"description": "Switches the camera view while you ride, based on where you look: first person straight ahead, third person looking down, selfie looking up. Angles, views and layers are all adjustable.",
	"authors": [
		"M.krabs"
	],
	"contact": {
		"homepage": "https://github.com/MKrabs/vantage",
		"sources": "https://github.com/MKrabs/vantage",
		"issues": "https://github.com/MKrabs/vantage/issues"
	},
	"license": "MIT",
	"icon": "assets/vantage/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.mkrabs.vantage.VantageClient"
		],
		"modmenu": [
			"de.mkrabs.vantage.config.VantageModMenu"
		]
	},
	"mixins": [
		{
			"config": "vantage.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
